{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sochse-public-site",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sochse.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
