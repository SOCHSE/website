---
import BaseLayout from "../layouts/BaseLayout.astro";
import ElixirWebsiteThumbnail from "../components/ElixirWebsiteThumbnail.astro";
import PageHero from "../components/PageHero.astro";
import { privateWork } from "../data/site";
---

<BaseLayout
  title="Selected work"
  description="Public website delivery and high-level descriptions of private founder-built systems."
  path="/work/"
>
  <PageHero
    eyebrow="Selected work"
    title="One public project. Several private systems."
    description="The public project can be visited. Private systems are described only at a high level and provide no public demo, repository, screenshot, data, access, or independent proof."
  />

  <section class="section">
    <div class="site-container">
      <article class="card grid overflow-hidden lg:grid-cols-[0.7fr_1.3fr]">
        <ElixirWebsiteThumbnail class="min-h-56 lg:min-h-72" showLocation />
        <div class="p-8 sm:p-10 lg:p-12">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-faint)]">Website migration + digital presence</p>
          <h2 class="mt-5 text-3xl font-semibold tracking-[-0.045em]">The story behind a physician-led Ayurveda centre.</h2>
          <p class="mt-5 max-w-2xl text-base leading-7 text-[var(--text-soft)]">
            Dr. Vijayakumar MD spent 10 years as Chief Ayurvedic Physician at
            Kempinski Hotel & Spa in Malta and eight years at Grecotel in
            Greece before returning to Kerala to found Elixir Ayurveda. The
            website brings together his 26-year journey, Elixir's philosophy,
            team, facilities, and international outlook in one clear public
            presence.
          </p>
          <a
            class="button button-secondary mt-8"
            href="https://elixirayurveda.com/"
            target="_blank"
            rel="noreferrer"
          >
            Visit website <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section divider">
    <div class="site-container">
      <div class="max-w-3xl">
        <span class="eyebrow">Private founder work</span>
        <h2 class="section-title">Capability descriptions, not public case studies.</h2>
        <p class="lede">
          These systems are private and unavailable for signup. Descriptions
          are founder-provided overviews; no public demonstration or independent
          verification is offered.
        </p>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {
          privateWork.map((project) => (
            <article class="card p-7 sm:p-8">
              <div class="flex flex-wrap items-center gap-2">
                <span class="tag">{project.label}</span>
                <span class="text-xs font-semibold text-[var(--accent)]">{project.state}</span>
              </div>
              <h3 class="mt-9 text-2xl font-semibold tracking-[-0.035em]">{project.title}</h3>
              <p class="mt-4 text-sm leading-7 text-[var(--text-soft)]">{project.description}</p>
              <p class="mt-7 border-t border-[var(--line)] pt-5 text-xs leading-5 text-[var(--text-faint)]">
                No public access, demo, proof, repository, private data, or release promise.
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
