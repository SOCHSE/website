---
import BaseLayout from "../layouts/BaseLayout.astro";
import { privateWork, services } from "../data/site";
---

<BaseLayout
  title="SOCHSE"
  description="Founder-led consulting and focused custom software for difficult business and technical problems."
  path="/"
>
  <section class="section relative overflow-hidden">
    <div class="site-container grid items-center gap-14 lg:grid-cols-[1.18fr_0.82fr]">
      <div>
        <span class="eyebrow">Consulting + focused software</span>
        <h1 class="display-title">Direction for difficult decisions.</h1>
        <p class="lede">
          SOCHSE helps businesses clarify hard problems, choose practical tools,
          and build focused systems when off-the-shelf software is not enough.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button button-primary" href="/contact/">
            Start a conversation
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href="/compass/">Explore Compass</a>
        </div>
        <p class="mt-7 text-sm text-[var(--text-faint)]">
          Consult first. Build only what helps. Leave you in control.
        </p>
      </div>

      <div class="card relative overflow-hidden p-3 sm:p-4">
        <div class="rounded-[1rem] border border-[var(--line)] bg-[var(--surface-solid)] p-5 shadow-[var(--shadow-sm)] sm:p-6">
          <div class="flex items-center justify-between border-b border-[var(--line)] pb-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-faint)]">Compass</p>
              <p class="mt-1 text-sm font-semibold">A clearer operating loop</p>
            </div>
            <span class="tag">Illustrative</span>
          </div>
          <div class="mt-6 space-y-3">
            {
              [
                ["Observe", "Bring signals into one calm view", "Connected"],
                ["Understand", "Explain what matters in plain language", "Clear"],
                ["Decide", "Present safe choices with context", "Controlled"],
                ["Learn", "Verify the result and adjust course", "Measured"],
              ].map(([title, copy, status], index) => (
                <div class="flex gap-4 rounded-xl border border-[var(--line)] bg-[var(--page)] p-4">
                  <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--accent-soft)] text-xs font-bold text-[var(--accent)]">
                    {index + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-3">
                      <p class="text-sm font-semibold">{title}</p>
                      <span class="text-[0.68rem] font-semibold text-[var(--success)]">{status}</span>
                    </div>
                    <p class="mt-1 text-xs leading-5 text-[var(--text-soft)]">{copy}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section divider">
    <div class="site-container">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <span class="eyebrow">What SOCHSE does</span>
          <h2 class="section-title">Practical help from question to working system.</h2>
        </div>
        <a class="text-link" href="/services/">View all services <span aria-hidden="true">→</span></a>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {
          services.map((service) => (
            <article class="card card-hover p-6 sm:p-7">
              <div class="flex items-start justify-between gap-4">
                <span class="text-xs font-bold tracking-[0.12em] text-[var(--accent)]">{service.number}</span>
                <span class="h-2 w-2 rounded-full bg-[var(--accent)] opacity-60" aria-hidden="true" />
              </div>
              <h3 class="mt-12 text-xl font-semibold tracking-[-0.025em]">{service.title}</h3>
              <p class="mt-3 max-w-lg text-sm leading-6 text-[var(--text-soft)]">{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section divider">
    <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <span class="eyebrow">SOCHSE Compass</span>
        <h2 class="section-title">Marketing direction. Under your control.</h2>
        <p class="lede">
          Compass is being built as a client-owned marketing portal: clear
          reporting, plain-English requests, and governed decisions without
          handing control of client data to a shared platform.
        </p>
        <a class="text-link mt-7" href="/compass/">How Compass is designed <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            ["Client-owned", "Installed separately for each client, with isolated data and credentials."],
            ["Plain-language", "A helpdesk for requests plus point-and-click actions for routine decisions."],
            ["Governed", "Preview, confirmation, limits, verification, and audit before sensitive changes."],
            ["Reusable", "Shared product capability without mixing one client's data with another's."],
          ].map(([title, description]) => (
            <article class="card p-6">
              <span class="block h-1.5 w-8 rounded-full bg-[var(--accent)]" aria-hidden="true" />
              <h3 class="mt-8 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--text-soft)]">{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section divider">
    <div class="site-container">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="section-title">Public delivery and private systems.</h2>
          <p class="lede">
            Public work can be visited. Private systems are founder-provided
            overviews with no public access or proof.
          </p>
        </div>
        <a class="text-link" href="/work/">See publication boundaries <span aria-hidden="true">→</span></a>
      </div>

      <article class="card mt-12 grid overflow-hidden lg:grid-cols-[0.75fr_1.25fr]">
        <div class="flex min-h-64 items-end bg-[var(--accent-soft)] p-7">
          <div>
            <span class="tag">Public website</span>
            <p class="mt-5 text-sm font-semibold text-[var(--accent)]">Elixir Ayurveda</p>
          </div>
        </div>
        <div class="p-7 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-faint)]">Website migration + digital presence</p>
          <h3 class="mt-4 text-2xl font-semibold tracking-[-0.035em]">A public healthcare website with a clearer foundation.</h3>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--text-soft)]">
            Publicly viewable work is limited to website migration and website
            delivery. Advertising, internal systems, infrastructure, and client
            operations are intentionally excluded.
          </p>
          <a
            class="text-link mt-7"
            href="https://elixirayurveda.com/"
            target="_blank"
            rel="noreferrer"
          >
            Visit elixirayurveda.com <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
          privateWork.slice(0, 3).map((project) => (
            <article class="card p-6">
              <div class="flex flex-wrap gap-2">
                <span class="tag">{project.label}</span>
              </div>
              <h3 class="mt-8 text-xl font-semibold">{project.title}</h3>
              <p class="mt-2 text-xs font-semibold text-[var(--accent)]">{project.state}</p>
              <p class="mt-4 text-sm leading-6 text-[var(--text-soft)]">{project.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section divider">
    <div class="site-container">
      <div class="card overflow-hidden bg-[var(--text)] p-8 text-[var(--page)] sm:p-12 lg:p-16">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.12em] opacity-60">Bring the difficult part</span>
            <h2 class="mt-5 max-w-3xl text-3xl font-semibold tracking-[-0.045em] sm:text-5xl">
              Start with the problem. Software comes later.
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-7 opacity-70">
              SOCHSE can help clarify a fragmented workflow, test a practical
              approach, and build the smallest useful system.
            </p>
          </div>
          <a class="button bg-[var(--page)] text-[var(--text)] hover:bg-white" href="/contact/">
            Start a conversation
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
