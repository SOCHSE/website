---
import Logo from "./Logo.astro";
import { navigation } from "../data/site";

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[color:var(--surface)] backdrop-blur-xl">
  <div class="site-container flex h-16 items-center justify-between">
    <Logo />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
              pathname.startsWith(item.href)
                ? "bg-[var(--accent-soft)] text-[var(--accent)]"
                : "text-[var(--text-soft)] hover:bg-[var(--page-muted)] hover:text-[var(--text)]",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--line)] text-[var(--text-soft)] transition-colors hover:border-[var(--line-strong)] hover:text-[var(--text)]"
        type="button"
        data-theme-toggle
        aria-label="Change color theme"
      >
        <svg class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42M7.06 16.94l-1.42 1.42" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/>
        </svg>
        <span class="sr-only" data-theme-label>Change color theme</span>
      </button>

      <a class="button button-primary header-cta" href="/contact/">Start a conversation</a>

      <button
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--line)] text-[var(--text-soft)] md:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation"
        data-menu-toggle
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 8h14M5 16h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-[var(--line)] bg-[var(--surface-solid)] px-3 py-3 data-[open]:block md:hidden"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    {
      navigation.map((item) => (
        <a
          class="block rounded-lg px-3 py-3 text-sm font-semibold text-[var(--text-soft)] hover:bg-[var(--page-muted)] hover:text-[var(--text)]"
          href={item.href}
        >
          {item.label}
        </a>
      ))
    }
    <a class="button button-primary mt-2 w-full" href="/contact/">Start a conversation</a>
  </nav>
</header>
