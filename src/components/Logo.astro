---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="group inline-flex items-center gap-2.5" href="/" aria-label="SOCHSE home">
  <svg
    class="h-7 w-7 text-[var(--accent)] transition-transform duration-200 group-hover:rotate-12"
    viewBox="0 0 32 32"
    aria-hidden="true"
  >
    <path
      d="M16 2.5 19.3 12.7 29.5 16l-10.2 3.3L16 29.5l-3.3-10.2L2.5 16l10.2-3.3L16 2.5Z"
      fill="currentColor"
    />
    <circle cx="16" cy="16" r="3" fill="var(--page)" />
  </svg>
  <span class="text-[0.95rem] font-bold tracking-[0.16em]">{compact ? "S" : "SOCHSE"}</span>
</a>
